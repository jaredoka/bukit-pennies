# Keep pnpm's virtual-store directory names short.
#
# Metro copies the on-disk path of every `require`d asset into the .app verbatim,
# as `assets/__node_modules/.pnpm/<virtual-store-dir>/...`. With pnpm's default
# 120-character limit, build 140 produced a 263-character path inside the IPA
# (an Ionicons font), which exceeds the 259-character limit zsign uses on
# Windows. The IPA could be built but not signed on this machine. 60 leaves
# roughly 80 characters of headroom for the scratch directory and zsign's own
# temporary files.
virtual-store-dir-max-length=60
